{
  "permissions": {
    "allow": [
      "Bash(xcodegen generate)",
      "Bash(xcrun simctl list *)",
      "Bash(xcodebuild -project MojSlownik.xcodeproj *)",
      "Bash(DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer xcodebuild *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-xcodebuild.sh" }
        ]
      }
    ]
  }
}
