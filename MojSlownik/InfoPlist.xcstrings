{
  "sourceLanguage" : "en",
  "strings" : {
    "NSCameraUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera is used to scan words and add them to your dictionary."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Камера нужна для сканирования слов и их добавления в словарь."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The microphone is used to dictate Polish words to add to your dictionary."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Микрофон нужен, чтобы диктовать польские слова для добавления в словарь."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speech recognition is used to enter Polish words by voice. Speech may be processed on Apple servers."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Распознавание нужно для ввода польских слов голосом. Речь может обрабатываться на серверах Apple."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
